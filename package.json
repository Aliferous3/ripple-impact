{
  "name": "ripple-impact",
  "version": "0.2.0-beta.1",
  "description": "Deterministic TypeScript change-impact engine \u00e2\u20ac\u201d see what a code change touches before you ship it",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aliferous3/ripple-impact.git"
  },
  "homepage": "https://github.com/Aliferous3/ripple-impact#readme",
  "bugs": "https://github.com/Aliferous3/ripple-impact/issues",
  "type": "module",
  "bin": {
    "ripple": "dist/cli/index.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "python",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "typescript",
    "change-impact",
    "dependency-analysis",
    "scip",
    "git-diff",
    "impact-analysis"
  ],
  "scripts": {
    "ripple": "tsx src/cli/index.ts",
    "index:fixtures": "tsx scripts/index-fixtures.ts",
    "inspect:scip": "tsx scripts/dump-scip.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "tsc -p tsconfig.build.json && npm run build:explorer",
    "build:explorer": "vite build --config vite.explorer.config.ts",
    "dev:explorer": "vite --config vite.explorer.config.ts",
    "typecheck": "tsc --noEmit && tsc -p explorer/tsconfig.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@sourcegraph/scip-python": "0.6.6",
    "@sourcegraph/scip-typescript": "^0.4.0",
    "chokidar": "^4.0.3",
    "typescript": "^5.9.0"
  },
  "devDependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/inter": "^5.2.5",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.20.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.0"
  }
}
