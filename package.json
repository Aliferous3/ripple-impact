{
  "name": "ripple",
  "version": "0.0.1",
  "private": true,
  "description": "Deterministic TypeScript change-impact engine — Tranche 0 technical spike",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "ripple": "tsx src/cli/index.ts",
    "index:fixtures": "tsx scripts/index-fixtures.ts",
    "inspect:scip": "tsx scripts/dump-scip.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:explorer": "vite build --config vite.explorer.config.ts",
    "dev:explorer": "vite --config vite.explorer.config.ts",
    "typecheck": "tsc --noEmit && tsc -p explorer/tsconfig.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@sourcegraph/scip-typescript": "^0.4.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "protobufjs": "^7.4.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "@xyflow/react": "^12.3.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
